# ===================================================================
# midi-map.yaml - Subsample MIDI routing map
# ===================================================================
#
# This file maps MIDI input (channel + note) to sample playback.
#
# How to use:
#   1. Copy this file to midi-map.yaml
#   2. Uncomment any of the EXAMPLES below to try them
#   3. Delete or comment out the ACTIVE assignments at the bottom
#      if you don't want the default drum kit + pitched keyboard
#   4. Save - Subsample reloads the map automatically
#
# Conventions:
#   Channels   1-16 (standard MIDI numbering)
#   Notes      36 (number), C3 (name), [36, 38] (list), C2..C4 (range),
#              drum.kick_1 (GM percussion symbolic name, case-insensitive)
#   Note names C4 = MIDI 60 (Ableton / Logic / FL Studio standard)
#              Sharps: C#4, D#4    Flats: Db4, Eb4
#   Drum names drum.kick_1, drum.snare_1, drum.hi_hat_closed, etc.
#              Full set: pymididefs.drums.GM_DRUM_MAP (GM percussion 27-87).
#              Drum names aren't sequential, so ranges (drum.x..drum.y)
#              aren't supported - use a list instead.
#
# Full grammar reference - every field, every predicate, every
# processor parameter:
#
#   README.md, section "MIDI map"
#
# Quick feel for the shape - three minimal examples.  Each one is a
# complete, working assignment.
#
#   # 1. Play one specific sample when you hit note 36
#   - name: Fixed kick
#     channel: 10
#     notes: drum.kick_1
#     select:
#       where:
#         name: 2026-03-24_14-37-14
#
#   # 2. Find the best kick in your library by similarity
#   - name: Any kick
#     channel: 10
#     notes: drum.kick_1
#     select:
#       where:
#         reference: samples/reference/GM36_BassDrum1.wav
#
#   # 3. Play the oldest pitched sample across a keyboard range,
#   #    pitch-shifted to each MIDI note
#   - name: Pitched keyboard
#     channel: 1
#     notes: C2..C6
#     select:
#       where: { pitched: true }
#       order: [{ by: age, dir: asc }]
#     process:
#       - repitch: true
#     one_shot: false
#
#   # 4. Velocity layering - two sounds on the same MIDI key.  Soft hits
#   #    (vel 0-63) play a soft sample; hard hits (vel 64-127) play a
#   #    different sample.  rescale: true remaps each layer's input
#   #    velocity to the full 0-127 range so each sample still gets full
#   #    dynamic expression.  See README "Velocity layering" for the dict
#   #    form, custom rescale ranges, and validation rules.
#   - name: Soft hat
#     channel: 10
#     notes: drum.closed_hi_hat
#     velocity:
#       trigger: [0, 63]
#       rescale: true
#     select:
#       where: { name_glob: "*soft_hat*" }
#   - name: Hard hat
#     channel: 10
#     notes: drum.closed_hi_hat
#     velocity:
#       trigger: [64, 127]
#       rescale: true
#     select:
#       where: { name_glob: "*hard_hat*" }
#
#   # 5. Zone-tuned - auto-distribute pitched samples across a keyboard.
#   #    Subsample filters the library to pitched samples (has_stable_pitch),
#   #    sorts by their detected pitches, and lays each sample across a
#   #    contiguous slice of MIDI keys centred on its own pitch.  Zone
#   #    boundaries meet at midpoints; the lowest sample extends down to
#   #    the keyboard floor and the highest extends up to the ceiling.
#   #    re-derived live whenever a new sample arrives, a bank switches,
#   #    or the MIDI map reloads.  See README "Zone-tuned" for details.
#   #
#   #    a) Full keyboard:
#   - name: Pitched library
#     channel: 1
#     notes: zone-tuned                 # shortcut — covers MIDI 0-127
#     process:
#       - repitch: true                 # required
#     select:
#       where:
#         duration: { gte: 0.5 }        # optional additional filters
#     one_shot: false                   # keyboard playing usually wants note-off
#
#   #    b) Split keyboard — two zone-tuned templates on one channel with
#   #       non-overlapping ranges:
#   - name: Bass zone
#     channel: 1
#     notes:
#       mode: zone-tuned
#       range: [0, 50]                  # MIDI ints or note names ("C-1".."G9")
#     process:
#       - repitch: true
#     select:
#       where: { name_glob: "*bass*" }
#     one_shot: false
#   - name: Lead zone
#     channel: 1
#     notes:
#       mode: zone-tuned
#       range: [51, 127]
#     process:
#       - repitch: true
#     select:
#       where: { name_glob: "*lead*" }
#     one_shot: false
#
# The rest of this file is:
#   EXAMPLES        commented-out assignments, ordered simple to
#                   advanced - uncomment any to try
#   ACTIVE          working assignments loaded at startup - a
#                   complete GM drum kit on channel 10 + a pitched
#                   keyboard on channel 1
#
# ===================================================================


assignments:


  # =================================================================
  # EXAMPLES - uncomment any of the following to try them
  # =================================================================


  # --- A. Specific sample by name ---
  # The simplest possible assignment.  `name:` matches a sample's
  # filename stem (no extension, no path).

  # - name: My favourite kick
  #   channel: 10
  #   notes: drum.kick_1
  #   select:
  #     where:
  #       name: 2026-03-24_14-37-14


  # --- B. Similarity match against a reference ---
  # Reference samples live in samples/reference/.  The similarity
  # engine ranks your library against the reference and plays the
  # closest match.  When `reference:` is set and `order:` is omitted,
  # similarity desc is assumed automatically.

  # - name: Any kick
  #   channel: 10
  #   notes: drum.kick_1
  #   select:
  #     where:
  #       reference: samples/reference/GM36_BassDrum1.wav


  # --- C. Newest capture on a keyboard, repitched ---
  # Selects the most-recently-captured sample across the whole note
  # range, pitch-shifted to each MIDI note.

  # - name: Latest capture
  #   channel: 2
  #   notes: C2..C6
  #   select:
  #     order: [{ by: age, dir: desc }]
  #     pick: 1
  #   process:
  #     - repitch: true
  #   one_shot: false


  # --- D. Highest-pitched sample ---
  # Filter by `pitched: true` (only samples with a stable detected
  # pitch), then sort by dominant pitch descending.

  # - name: High tone
  #   channel: 4
  #   notes: C3..C5
  #   select:
  #     where:
  #       pitched: true
  #     order: [{ by: pitch, dir: desc }]
  #     pick: 1
  #   process:
  #     - repitch: true
  #   one_shot: false


  # --- E. Third-longest sample ---
  # `pick: 3` takes the third result in the sorted list rather than
  # the first.  Handy for stepping through ranks.
  #
  # `pick` also accepts a range — `[1, 3]` (or the equivalent
  # `{ gte: 1, lte: 3 }`) draws a fresh random rank in 1..3 on every
  # hit, so the same pad picks one of your top-three matches with
  # natural variation instead of always playing the best match.
  #
  # When a range pick is given on a multi-note assignment, every note
  # rolls independently at trigger time — no need to write a separate
  # assignment per note for variety.

  # - name: Third longest
  #   channel: 5
  #   notes: 60
  #   select:
  #     order: [{ by: duration, dir: desc }]
  #     pick: 3

  # - name: Top-three kick
  #   channel: 10
  #   notes: drum.kick_1
  #   select:
  #     where: { reference: BD0025 }
  #     pick: [1, 3]   # different kick on every hit, from your closest 3


  # --- F. Rhythmic loops, beat-matched ---
  # Filter by duration and onset count, then snap the chosen sample
  # to the session's target_bpm grid.

  # - name: Loop pad
  #   channel: 3
  #   notes: C2..C4
  #   select:
  #     where:
  #       duration: { gte: 1.0 }    # at least 1 second
  #       onsets:   { gte: 4 }      # with at least 4 transients
  #     order: [{ by: age, dir: desc }]
  #     pick: 1
  #   process:
  #     - stretch_quantize: { grid: 16 }
  #   one_shot: false


  # --- G. Warm keys - filter + saturation + compression + repitch ---
  # Processors in `process:` run in declaration order.  Here the
  # sample is low-passed, saturated for analog warmth, compressed,
  # then pitch-shifted.

  # - name: Warm keys
  #   channel: 6
  #   notes: C2..C6
  #   select:
  #     where: { pitched: true }
  #     order: [{ by: age, dir: asc }]
  #   process:
  #     - filter_low: { freq: 2000, resonance: 6 }
  #     - saturate: { drive: 4 }
  #     - compress: true
  #     - repitch: true
  #   one_shot: false


  # --- H. Reversed pad ---
  # `reverse: true` flips the sample end-to-end before repitch runs,
  # giving a breathy attack-from-nothing character.

  # - name: Reverse pad
  #   channel: 7
  #   notes: C3..C5
  #   select:
  #     where: { pitched: true, duration: { gte: 0.5 } }
  #     order: [{ by: age, dir: asc }]
  #   process:
  #     - reverse: true
  #     - repitch: true
  #   one_shot: false


  # --- I. Fallback chain ---
  # `select:` can be a list of specs tried in order - the first one
  # that yields a match wins.  Here: try a specific named sample
  # first; if it's not in the library, fall back to the best kick.

  # - name: Kick with fallback
  #   channel: 10
  #   notes: drum.kick_1
  #   select:
  #     - where: { name: my-favourite-kick }
  #     - where: { reference: samples/reference/GM36_BassDrum1.wav }


  # --- J. Beat-pattern match ---
  # `beat_match` ranks samples by how closely their per-beat energy
  # matches a supplied pattern.  The pattern is a list of numbers in
  # [0, 1], one per beat - each value is a target relative energy for
  # that beat.  The example below finds loops whose energy lands on
  # even beats (1, 3, 5, 7) and is quiet on odd beats.  Requires a
  # `stretch_quantize` or `pad_quantize` step in the same assignment -
  # samples without a quantized variant are excluded from the result.

  # - name: Beat-pattern loop
  #   channel: 3
  #   notes: C2..C3
  #   select:
  #     where:
  #       duration: { gte: 1.0 }
  #       onsets:   { gte: 4 }
  #     order:
  #       - { by: beat_match, pattern: [1, 0, 1, 0, 1, 0, 1, 0] }
  #   process:
  #     - stretch_quantize: { grid: 16 }
  #   one_shot: false


  # --- K. Channel-pattern extraction at playback time ---
  # `extract:` collapses a multi-channel sample to a 1-channel sub-signal
  # emulating a named microphone pickup pattern.  Useful when you want a
  # stereo sample to play dead-centre mono (kick), or to pull the side
  # content of an M/S recording for a stereo-spread snare, etc.
  #
  # Vocabulary (works across PCM mono/stereo/quad/5.1/7.1 and Ambisonic
  # B-format - silently chooses the right channels for the format):
  #   omni     equal-energy sum (M of M/S; W of B-format; full downmix)
  #   side     left-right figure-eight    (L-R for stereo; Y for B-format)
  #   depth    front-back figure-eight    (B-format X; surround only)
  #   height   up-down figure-eight       (B-format Z only)
  #   left     left-facing cardioid       (L for stereo)
  #   right    right-facing cardioid      (R for stereo)
  #   front    forward cardioid           (front speakers)
  #   back     rear cardioid              (surround/B-format only)
  #   channel.N  literal Nth input channel (1-indexed escape hatch)
  #
  # `extract:` runs BEFORE `pan:` and `output:` - the mono extract is
  # then routed across output channels as usual.  Incompatible patterns
  # (e.g. `depth` on a stereo source) are rejected at map load.

  # - name: Mono kick
  #   channel: 10
  #   notes: drum.kick_1
  #   select:
  #     where: { reference: samples/reference/GM36_BassDrum1.wav }
  #   extract: omni    # stereo source → mono, distributed equally to all outputs


  # =================================================================
  # ACTIVE - a complete starter kit, loaded at startup
  # =================================================================
  #
  # Channel 10 carries a General MIDI drum kit backed by the
  # similarity engine: each assignment targets a GM reference sample
  # and plays the closest match from your library.  Multi-note
  # assignments distribute ranks (first note = best match, second =
  # second-best, etc).
  #
  # Channel 1 is a pitched keyboard: the oldest pitched sample in
  # your library, repitched to each incoming MIDI note across the
  # full keyboard range.
  #
  # Delete or comment out anything you don't want.


  # --- Kicks ---
  # GM notes 36 (Bass Drum 1) and 35 (Acoustic Bass Drum).

  - name: Kicks
    channel: 10
    notes: [drum.kick_1, drum.kick_2]
    select:
      where:
        reference: samples/reference/GM36_BassDrum1.wav
      order: [{ by: similarity, dir: desc }]


  # --- Snares ---
  # GM notes 38 (Acoustic Snare) and 40 (Electric Snare).

  - name: Snares
    channel: 10
    notes: [drum.snare_1, drum.snare_2]
    select:
      where:
        reference: samples/reference/GM38_AcousticSnare.wav
      order: [{ by: similarity, dir: desc }]
    pan: [50, 87]


  # --- Side stick ---
  # GM note 37 (Side Stick / Rim Shot).

  - name: Side stick
    channel: 10
    notes: drum.side_stick
    select:
      where:
        reference: samples/reference/GM37_SideStick.wav
      order: [{ by: similarity, dir: desc }]


  # --- Clap ---
  # GM note 39 (Hand Clap).

  - name: Clap
    channel: 10
    notes: drum.hand_clap
    select:
      where:
        reference: samples/reference/GM39_HandClap.wav
      order: [{ by: similarity, dir: desc }]


  # --- Toms ---
  # GM notes 41 (Low Floor Tom), 43 (High Floor Tom), 45 (Low Tom),
  # 47 (Low-Mid Tom), 48 (Hi Mid Tom), 50 (High Tom).

  - name: Toms
    channel: 10
    notes: [drum.high_tom, drum.high_mid_tom, drum.low_mid_tom, drum.low_tom, drum.high_floor_tom, drum.low_floor_tom]
    select:
      where:
        reference: samples/reference/GM48_HiMidTom.wav
      order: [{ by: similarity, dir: desc }]


  # --- Closed hi-hat ---
  # GM notes 42 (Closed Hi-Hat), 44 (Pedal Hi-Hat).

  - name: Closed hi-hat
    channel: 10
    notes: [drum.hi_hat_closed, drum.hi_hat_pedal]
    select:
      where:
        reference: samples/reference/GM42_ClosedHiHat.wav
      order: [{ by: similarity, dir: desc }]
    pan: [87, 50]


  # --- Open hi-hat ---
  # GM note 46 (Open Hi-Hat).

  - name: Open hi-hat
    channel: 10
    notes: drum.hi_hat_open
    select:
      where:
        reference: samples/reference/GM46_OpenHiHat.wav
      order: [{ by: similarity, dir: desc }]
    pan: [87, 50]


  # --- Crashes and splash ---
  # GM notes 49 (Crash 1), 57 (Crash 2), 55 (Splash), 52 (Chinese Cymbal).

  - name: Crashes
    channel: 10
    notes: [drum.crash_1, drum.crash_2, drum.splash_cymbal, drum.chinese_cymbal]
    select:
      where:
        reference: samples/reference/GM49_CrashCymbal1.wav
      order: [{ by: similarity, dir: desc }]


  # --- Ride ---
  # GM notes 51 (Ride Cymbal 1), 59 (Ride Cymbal 2), 53 (Ride Bell).

  - name: Ride
    channel: 10
    notes: [drum.ride_1, drum.ride_2, drum.ride_bell]
    select:
      where:
        reference: samples/reference/GM51_RideCymbal1.wav
      order: [{ by: similarity, dir: desc }]
    pan: [25, 75]


  # --- Cowbell ---
  # GM note 56 (Cowbell).

  - name: Cowbell
    channel: 10
    notes: drum.cowbell
    select:
      where:
        reference: samples/reference/GM56_Cowbell.wav
      order: [{ by: similarity, dir: desc }]
    gain: -3.0


  # --- Tambourine ---
  # GM note 54 (Tambourine).

  - name: Tambourine
    channel: 10
    notes: drum.tambourine
    select:
      where:
        reference: samples/reference/GM54_Tambourine.wav
      order: [{ by: similarity, dir: desc }]


  # --- Claves ---
  # GM note 75 (Claves).

  - name: Claves
    channel: 10
    notes: drum.claves
    select:
      where:
        reference: samples/reference/GM75_Claves.wav
      order: [{ by: similarity, dir: desc }]


  # --- Pitched keyboard ---
  # Plays the oldest pitch-stable sample across the full note range,
  # pitch-shifted to each MIDI note.

  - name: Pitched keyboard
    channel: 1
    notes: C-1..G9
    select:
      where:
        pitched: true
      order: [{ by: age, dir: asc }]
      pick: 1
    process:
      - repitch: true
    one_shot: false
